# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Object storage — S3-compatible (Wasabi on Hostinger stack, or E2E / other)
# Wasabi (recommended with Hostinger): create bucket in ap-southeast-1 for India latency
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_REGION=ap-southeast-1
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_B2B_BUCKET=bharatcloud-vault

# Legacy names (still supported; ignored when WASABI_* is set)
E2E_S3_ENDPOINT=
E2E_S3_ACCESS_KEY=
E2E_S3_SECRET_KEY=
E2E_S3_REGION=us-east-1
E2E_S3_B2B_BUCKET=bharatcloud-vault

# Payments
RAZORPAY_KEY=

# Demo fallback company id when Supabase off
B2B_DEMO_COMPANY_ID=demo-company-001
