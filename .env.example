# --- App ---
NEXT_PUBLIC_APP_URL=https://www.bharatcloud.store
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: anon key if client-side Supabase is added later
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Workspace / tenant (local demo without Supabase) ---
DEMO_COMPANY_DOMAIN=demo.example.com
B2B_DEMO_COMPANY_ID=demo-company-001

# --- Auth & security ---
BC_PIN_SALT=
CRON_SECRET=
# AES-256-GCM for google_oauth_tokens (required in production)
ENCRYPTION_KEY=


# --- Google OAuth (Drive / Gmail / Contacts readonly) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1-click Drive + Gmail OAuth (Settings → Integrations, My mail archive)
# Google Cloud: enable Gmail API + add scopes to OAuth consent screen
# Must match an Authorized redirect URI in Google Cloud Console (add all you use):
GOOGLE_REDIRECT_URI=https://www.bharatcloud.store/api/auth/google/drive/callback
# Legacy (still supported): https://www.bharatcloud.store/api/auth/callback/google
# Optional: override all OAuth scopes (space-separated)
# Optional — leave UNSET to use app defaults. Do NOT use bare .../auth/drive or .../auth/gmail (invalid_scope).
# GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.metadata https://www.googleapis.com/auth/userinfo.email openid profile
# Optional: team login OAuth if GOOGLE_REDIRECT_URI is the drive callback above
# GOOGLE_OAUTH_REDIRECT_URI=https://www.bharatcloud.store/api/auth/google/callback

# --- Object storage (S3-compatible: Wasabi, AWS, E2E, MinIO) ---
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_REGION=ap-southeast-1
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_B2B_BUCKET=bharatcloud-vault
WASABI_ARCHIVE_BUCKET=

# E2E Mumbai — all data archived from day 1 (Hostinger app; billing via Paytm)
E2E_S3_ENDPOINT=https://objectstore.ap-mumbai-1.e2enetworks.net
E2E_S3_ACCESS_KEY=
E2E_S3_SECRET_KEY=
E2E_S3_REGION=ap-mumbai-1
E2E_S3_B2B_BUCKET=bharatcloudfinal2
STORAGE_MODE=ARCHIVE_FROM_START
ARCHIVE_S3_BUCKET=bharatcloudfinal2
ARCHIVE_STORAGE_CLASS=GLACIER
ARCHIVE_S3_STORAGE_CLASS=GLACIER

# --- Super admin (platform console /admin/payments) ---
# Comma-separated; defaults include support@bharatcloud.com (+ legacy .store aliases)
# SUPER_ADMIN_EMAILS=support@bharatcloud.com
# Set on Vercel only — never commit:
# SUPER_ADMIN_PASSWORD=
# Require super admin OK before any employee connects Gmail/Drive (default off)
# GMAIL_CONNECT_REQUIRES_APPROVAL=1

# --- Payments ---
# Real UPI collect: set BILLING_UPI_LIVE=1 and your VPA. Until then billing is rehearsal (super admin approves).
BILLING_UPI_LIVE=0
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=
PAYMENT_AUTO_APPROVE=0
# Skips 402 backup gate for all tenants (demo only). Prefer DEMO tenant profile / domain bypass instead.
PAYMENT_BYPASS=0
# Optional extra demo domains (comma-separated).
# DEMO_BYPASS_DOMAINS=
# Checkout and billing open Paytm only (paytmmp://). Set the Paytm VPA.
NEXT_PUBLIC_PAYTM_UPI_ID=
NEXT_PUBLIC_PAYTM_PAYEE_NAME=Bharat Cloud
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → https://YOUR-DOMAIN/api/razorpay/webhook
# Events: payment_link.paid, payment.captured

# --- Email (recovery, notifications) ---
RESEND_API_KEY=
# EMAIL_FROM=noreply@bharatcloud.store
# Resend: verify domain at resend.com/domains, or test with:
# COMPANY_MAIL_FROM=onboarding@resend.dev
# RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Public branding (optional overrides) ---
# NEXT_PUBLIC_BRAND_NAME=BharatCloud

# --- Product gates (B2B go-live: leave unset) ---
# ENABLE_B2C=1
# ENABLE_DEMO_LOGINS=1
# Email/Gmail archive (staff: My mail archive + forward via company admin_email)
# ENABLE_EMAIL_BACKUP=1
# RESEND_API_KEY=...  # required for staff forward
# COMPANY_MAIL_FROM="Bharat Cloud <company@bharatcloud.store>"
